<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#FFF9F4">

    <!-- Título -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/available_offers"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#45281F" />

    <!-- Nombre del producto -->
    <TextView
        android:id="@+id/txtOfferName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#45281F"
        tools:text="Hamburguesa sencilla" />

    <!-- Descripción -->
    <TextView
        android:id="@+id/txtOfferDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="#8B7B73"
        tools:text="Hamburguesa con queso, papas y bebida." />

    <!-- Precio -->
    <TextView
        android:id="@+id/txtOfferPrice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#C45C42"
        tools:text="₡2.030" />

    <!-- Cantidad disponible -->
    <TextView
        android:id="@+id/txtOfferQuantity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="#45281F"
        tools:text="Cantidad disponible: 5" />

</LinearLayout>
