<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FFF9F4">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Encabezado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="‹"
                android:textColor="#C45C42"
                android:textSize="30sp"
                android:contentDescription="@string/register_back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="@string/register_title"
                android:textColor="#45281F"
                android:textSize="21sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/register_subtitle"
            android:textColor="#8B7B73"
            android:textSize="12sp" />

        <!-- Nombre -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/register_full_name"
            android:textColor="#45281F"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/card_background"
            android:hint="@string/register_name_hint"
            android:inputType="textPersonName"
            android:padding="12dp"
            android:textSize="13sp" />

        <!-- Correo -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="@string/register_email"
            android:textColor="#45281F"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/card_background"
            android:hint="@string/register_email_hint"
            android:inputType="textEmailAddress"
            android:padding="12dp"
            android:textSize="13sp" />

        <!-- Teléfono -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="@string/register_phone"
            android:textColor="#45281F"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/card_background"
            android:hint="@string/register_phone_hint"
            android:inputType="phone"
            android:padding="12dp"
            android:textSize="13sp" />

        <!-- Contraseña -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="@string/register_password"
            android:textColor="#45281F"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/card_background"
            android:hint="@string/register_password_hint"
            android:inputType="textPassword"
            android:padding="12dp"
            android:textSize="13sp" />

        <!-- Confirmar contraseña -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="@string/register_confirm_password"
            android:textColor="#45281F"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/card_background"
            android:hint="@string/register_confirm_hint"
            android:inputType="textPassword"
            android:padding="12dp"
            android:textSize="13sp" />

        <!-- Términos y condiciones -->
        <CheckBox
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:buttonTint="#C45C42"
            android:text="@string/register_terms"
            android:textColor="#45281F"
            android:textSize="12sp" />

        <!-- Botón registrarse -->
        <Button
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="18dp"
            android:backgroundTint="#C45C42"
            android:text="@string/register_button"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <!-- Iniciar sesión -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:text="@string/register_login_link"
            android:textColor="#C45C42"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>
