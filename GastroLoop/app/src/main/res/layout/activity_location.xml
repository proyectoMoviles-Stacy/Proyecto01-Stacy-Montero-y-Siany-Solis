<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FFF9F4">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Encabezado -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/restaurant_location_title"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#45281F" />

        <!-- Imagen del restaurante -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="25dp"
            android:gravity="center"
            android:text="@string/burger_restaurant"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#45281F"
            android:background="@drawable/restaurant_background" />

        <!-- Información -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/burger_restaurant"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#45281F" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/restaurant_category_location"
            android:textSize="13sp"
            android:textColor="#8B7B73" />

        <!-- Dirección -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:padding="15dp"
            android:background="@drawable/card_background">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/restaurant_full_address"
                android:textStyle="bold"
                android:textColor="#45281F" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/restaurant_pickup_note"
                android:textSize="13sp"
                android:textColor="#8B7B73" />

        </LinearLayout>

        <!-- Mapa -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="@string/map_section_title"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#45281F" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="⊕"
            android:textSize="48sp"
            android:textColor="#C45C42"
            android:background="#E5E8DF" />

        <!-- Botón -->
        <Button
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="45dp"
            android:text="@string/view_restaurant_offers"
            android:textColor="#FFFFFF"
            android:backgroundTint="#C45C42" />

    </LinearLayout>
</ScrollView>
